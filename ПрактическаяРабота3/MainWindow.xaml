<Window x:Class="ПрактическаяРабота3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПрактическаяРабота3"
        mc:Ignorable="d"
        Title="Игра-кликер" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid
    Background="#FF424242">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border
        BorderBrush="Black"
        BorderThickness="1"
        Margin="10"
        Background="#FFFDFDFD">

            <Grid>
                <Image
                Margin="10,10,10.2,185.4"
                Source="/knight1.jpg"/>
                <Label
                    
                Content="Основные характеристики персонажа:"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontWeight="Bold"
                Margin="10, 0, 0, 160"/>
                <Label
                Content="Жизненные показатели: 100"
                    x:Name="playerHealth"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 130"/>
                <Label
                Content="Броня: 100"
                    x:Name="playerArmor"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 100"/>
                <Label
                Content="Уровень: 1"
                    x:Name="playerLevel"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 70"/>
                <Label
                Content="Опыт: 0"
                    x:Name="playerGlasses"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 40"/>
                <Label
                Content="Монеты: 0"
                    x:Name="playerMoney"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 10"/>
                <Button Margin="209,346,74,42" Content="Оглушение" Click="Button_Click" Name="Оглушение"></Button>
            </Grid>
        </Border>
        <Border
        MouseDown = "AttackEnemy"
        BorderBrush="Black"
        BorderThickness="1"
        Margin="10"
        Background="#FFFDFDFD"
        Grid.Column="1">
            

            <Grid>
                <Image
                x:Name="emptyImage"
                Margin="10,10,10.2,185.4"
                Source="/monstr3.jpeg"/>
                <Label
                Content="Основные характеристики персонажа:"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontWeight="Bold"
                Margin="10, 0, 0, 160"/>
                <Label
                Content="Жизненные показатели: 100"
                    x:Name="emptyHealth"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 130"/>
                <Label
                Content="Броня: 100"
                    x:Name="emptyArmor"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10, 0, 0, 100"/>
                
            </Grid>
        </Border>
        
    </Grid>

</Window>
